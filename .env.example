# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://oldphotoliveai.com

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=oldphotolive-ai
NEXT_PUBLIC_R2_DOMAIN=cdn.oldphotoliveai.com

# Replicate
REPLICATE_API_TOKEN=
# Soft monthly USD ceiling (estimated). Replicate deprecated dashboard spend limits.
REPLICATE_MONTHLY_SPEND_LIMIT_USD=50
# Set to 0/false to disable the in-app spend guard (not recommended).
REPLICATE_SPEND_GUARD_ENABLED=true

# Content moderation provider: replicate (default) | openai | auto
# replicate = falcons-ai NSFW classifier via existing REPLICATE_API_TOKEN (no OpenAI card)
# openai   = OpenAI Moderation API (requires working OPENAI_API_KEY billing)
# auto     = try OpenAI first, fall back to Replicate on failure
MODERATION_PROVIDER=replicate

# OpenAI Moderation (optional — only needed if MODERATION_PROVIDER=openai|auto)
OPENAI_API_KEY=

# Stripe (required for live payments)
STRIPE_SECRET_KEY=sk_test_placeholder
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Optional legacy/pre-created Stripe prices. One-time credit packs use Checkout price_data by default.
STRIPE_PRICE_PAY_AS_YOU_GO=price_placeholder_payg
STRIPE_PRICE_STARTER_PACK=price_placeholder_starter_pack
STRIPE_PRICE_FAMILY_PACK=price_placeholder_family_pack
STRIPE_PRICE_ARCHIVE_PACK=price_placeholder_archive_pack
STRIPE_PRICE_PROFESSIONAL=price_placeholder_pro

# Google Analytics (Optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
GOOGLE_SITE_VERIFICATION=

# Email notifications via Resend (Optional)
RESEND_API_KEY=
RESEND_FROM_EMAIL=OldPhotoLive AI <noreply@yourdomain.com>

# Worker 安全密钥（防止外部触发 Worker）
WORKER_SECRET=

# Internal admin API key (for /api/internal/admin/tier)
ADMIN_API_KEY=
